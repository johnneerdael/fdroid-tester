#!/usr/bin/env bash
# Fake curl for the tests: serves the fixtures in $FAKE by address.
set -u
printf '%s\n' "$*" >> "$FAKE/curl.log"
out=""; fmt=""; url=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift ;;
    -w) fmt="$2"; shift ;;
    -m|-H|-F) shift ;;
    http*) url="$1" ;;
  esac
  shift
done
# FAKE_GITLAB_DOWN: gitlab.com cannot be reached
if [ -n "${FAKE_GITLAB_DOWN:-}" ]; then case "$url" in *gitlab.com*) exit 7 ;; esac; fi
serve() { if [ -n "$out" ]; then cp "$1" "$out"; else cat "$1"; fi; }
code=200
case "$url" in
  *reports.exodus-privacy.eu.org*) printf '{"trackers": {}}' > "$FAKE/trackers.json"; serve "$FAKE/trackers.json" ;;
  */projects/fdroid%2Ffdroiddata) : ;;
  */projects/fdroid%2Ffdroiddata/merge_requests/*) serve "$FAKE/mr.json" ;;
  *codequality_reports.json) serve "$FAKE/cq.json" ;;
  *.apk) serve "$FAKE/app.apk" ;;
  */repository/files/metadata%2F*) serve "$FAKE/meta.yml" ;;
  */api/v3/files/*)
    if [ -s "$FAKE/vt-file.json" ]; then serve "$FAKE/vt-file.json"; else code=404; fi ;;
  */api/v3/files)
    if [ -s "$FAKE/vt-upload.json" ]; then serve "$FAKE/vt-upload.json"; else code=404; fi ;;
  */api/v3/analyses/*)
    if [ -s "$FAKE/vt-analysis.json" ]; then serve "$FAKE/vt-analysis.json"; else code=404; fi ;;
  *) code=404; [ -n "$fmt" ] || exit 22 ;;
esac
[ -n "$fmt" ] && printf '%s' "$code"
exit 0
